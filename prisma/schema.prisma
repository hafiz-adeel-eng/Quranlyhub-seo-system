// Rishta Pakistan — matrimonial platform schema
// Postgres in production (Vercel's serverless filesystem is ephemeral/read-only,
// so SQLite cannot be used there). For quick local hacking without a network
// dependency you can temporarily switch `provider` back to "sqlite".
// NOTE: Gender/MaritalStatus/Sect/UnlockStatus are plain Strings rather than
// native Prisma enums — the allowed values are defined once in src/lib/enums.ts
// and validated in application code. This keeps the schema portable between
// SQLite (no enum support) and Postgres without touching application code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String?
  passwordHash  String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       Profile?
  unlocksBought ContactUnlock[] @relation("BuyerUnlocks")
}

model City {
  id        String    @id @default(cuid())
  slug      String    @unique // e.g. "gujranwala"
  nameUr    String    // e.g. "گوجرانوالہ"
  nameEn    String    // e.g. "Gujranwala"
  province  String?
  isFeatured Boolean  @default(true)

  profiles  Profile[]
}

model Profile {
  id             String        @id @default(cuid())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String        @unique

  fullName       String
  gender           String // "MALE" | "FEMALE"
  lookingForGender String // "MALE" | "FEMALE"
  age            Int
  height         String?
  maritalStatus  String        @default("SINGLE") // SINGLE | DIVORCED | WIDOWED | KHULA
  sect           String        @default("OTHER")  // SUNNI | SHIA | AHLE_HADITH | DEOBANDI | BARELVI | OTHER
  caste          String?
  education      String?
  profession     String?
  income         String?

  city           City          @relation(fields: [cityId], references: [id])
  cityId         String

  bioUr          String?
  bioEn          String?

  contactPhone   String
  contactWhatsapp String?

  photoUrl       String?
  isPublished    Boolean       @default(true)
  isVerified     Boolean       @default(false)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  unlocks        ContactUnlock[] @relation("ProfileUnlocks")

  @@index([cityId, gender, isPublished])
}

model ContactUnlock {
  id            String        @id @default(cuid())
  buyer         User          @relation("BuyerUnlocks", fields: [buyerId], references: [id], onDelete: Cascade)
  buyerId       String
  profile       Profile       @relation("ProfileUnlocks", fields: [profileId], references: [id], onDelete: Cascade)
  profileId     String

  amountPkr     Int
  status        String        @default("PENDING") // PENDING | PAID | FAILED
  provider      String        @default("manual") // manual | jazzcash | easypaisa | stripe
  providerRef   String?       // transaction id / reference number from gateway or user-submitted receipt

  createdAt     DateTime      @default(now())
  paidAt        DateTime?

  @@unique([buyerId, profileId])
  @@index([status])
}
