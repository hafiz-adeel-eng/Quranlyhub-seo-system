# Path to the Google service account JSON key (never commit the real file)
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json

# Search Console property, exactly as it appears in GSC (URL-prefix or sc-domain:)
GSC_SITE_URL=https://hobartappliancecare.com/

# GA4 property ID (numbers only, e.g. 123456789) from GA4 Admin > Property Settings
GA4_PROPERTY_ID=
