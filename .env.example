# Postgres connection string (e.g. from Neon, Supabase, or Vercel Postgres).
# Vercel's serverless filesystem can't host SQLite, so this must be Postgres
# for any deployment there — see README.md's "Deploying to Vercel" section.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Used in metadata, sitemap.xml and canonical URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Comma-separated emails allowed to open /admin/unlocks and approve payments.
ADMIN_EMAILS="you@example.com"

# Shown on the manual JazzCash/Easypaisa checkout screen until a real
# payment gateway is integrated (see README.md).
MANUAL_PAYMENT_NUMBER="0300-0000000"
MANUAL_PAYMENT_NAME="Rishta Pakistan"
